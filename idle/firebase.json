{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["cp \"$PROJECT_DIR/regras.js\" \"$PROJECT_DIR/functions/regras.js\""]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.*", "functions/**", "**/.*", "**/node_modules/**", "README.md", "*.bak"]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
