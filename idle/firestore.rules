rules_version = '2';
// Regras do Saque Infinito.
// Tudo que mexe com ouro ou com dono de item passa pelas Cloud Functions (functions/index.js);
// o aplicativo só lê o mercado e grava o próprio progresso.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }

    // anúncios e histórico de preços: todos leem, só o servidor grava
    match /anuncios/{id} { allow read: if logado(); allow write: if false; }
    match /historico/{id} { allow read: if logado(); allow write: if false; }

    // ouro oficial de cada jogador: só o próprio lê, só o servidor grava
    match /carteiras/{uid} { allow read: if eu(uid); allow write: if false; }

    // registro de quem é dono de cada item já negociado: só o servidor
    match /donos/{id} { allow read, write: if false; }

    // progresso do jogador (party, mochila, pets). Limite de tamanho para evitar abuso.
    match /jogadores/{uid} {
      allow read: if eu(uid);
      allow write: if eu(uid) && request.resource.size() < 900000;

      // caixa de entrada: itens comprados ou devolvidos e avisos de venda.
      // O servidor cria; o jogador só lê e apaga depois de receber.
      match /caixa/{id} { allow read, delete: if eu(uid); allow create, update: if false; }
    }
  }
}
